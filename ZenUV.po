msgctxt "Operator"
msgid "Auto Unwrap"
msgstr "自动展开"

msgid "Automated UV unwrapper based on utility, written by {MinistryOfFlatData.MINISTRY_OF_FLAT_AUTHOR} {MinistryOfFlatData.MINISTRY_OF_FLAT_TEXT}"
msgstr "基于工具链的自动化 UV 展开器，由 {MinistryOfFlatData.MINISTRY_OF_FLAT_AUTHOR} {MinistryOfFlatData.MINISTRY_OF_FLAT_TEXT} 编写"

msgid "Force Hard Surface"
msgstr "强制硬表面"

msgid "Makes the algorithm treat the surface as Hard Surface, ensuring precise handling of sharp edges and rigid structures"
msgstr "使算法将表面视为硬表面，确保对锐利边缘和刚性结构的精确处理"

msgid "Separate By Material"
msgstr "按材质分离"

msgid "Mesh is splitted by materials before unwrapping"
msgstr "在展开前根据材质拆分网格"

msgid "Separate By Sharp Edges"
msgstr "按锐利边缘分离"

msgid "Mesh is splitted by sharp edges before unwrapping"
msgstr "在展开前根据锐利边缘拆分网格"

msgid "Triangulate Mesh"
msgstr "三角化网格"

msgid "All ngons with four or more vertices will be triangulated"
msgstr "所有具有四个或更多顶点的多边形将被三角化"

msgid "Auto Detect Hard Edges"
msgstr "自动检测硬边"

msgid "UV unwrapper will try to separate all hard edges. Useful for lightmapping and Normalmapping"
msgstr "UV 展开器将尝试分离所有硬边。适用于光照贴图法线贴图"

msgid "Use Normal"
msgstr "使用法线"

msgid "Use the models normals to help classify polygons"
msgstr "使用法线辅助分类多边形"

msgid "Overlap Identical Parts"
msgstr "重叠相同部分"

msgid "Overlap identtical parts to take up the same texture space"
msgstr "重叠相同的部分以占用相同的纹理空间"

msgid "Overlap Mirrored parts"
msgstr "重叠镜像部分"

msgid "Overlap mirrored parts to take up the same texture space"
msgstr "重叠镜像的部分以占用相同的纹理空间"

msgid "Scale UV to Worldspace"
msgstr "将 UV 缩放到世界空间"

msgid "Scales the UVs to match their real world scale going beyound the zero to one range"
msgstr "将 UV 缩放至与其真实世界比例相匹配，超出 0 到 1 的范围"

msgid "Use Texel Density"
msgstr "使用纹理密度"

msgid "Scales the UVs to match the texel density value"
msgstr "将 UV 缩放至与纹理密度值匹配"

msgid "Mark Seams"
msgstr "标记接缝"

msgid "Automatically assign seams"
msgstr "自动分配接缝"

msgid "Correct Self-Intersecting"
msgstr "修正自相交"

msgid "Correct uv faces that have self-intersecting uv edges"
msgstr "修正 UV 面中自相交的 UV 边缘"

msgid "Stretch"
msgstr "拉伸"

msgid "Stretch any island that is too wide to fit in the image"
msgstr "拉伸任何因过宽而无法放入图像中的岛屿"

msgid "Packing"
msgstr "打包"

msgid "Pack islands in to a rectangle"
msgstr "将岛屿打包到矩形中"

msgid "Cut"
msgstr "切割"

msgid "Cut down awkward shapes in order to optimize layout coverage"
msgstr "通过裁剪不规整的形状以优化布局覆盖率"

msgid "Squares"
msgstr "正方形"

msgid "Finds various individual polygons that have right angles"
msgstr "查找具有直角的各个独立多边形"

msgid "Quads"
msgstr "四边形"

msgid "Searches the model for triangle pairs that make good quads. Improves the use of patches"
msgstr "搜索模型中形成良好四边形的三角形对。改进补丁的使用"

msgid "Vertex Weld"
msgstr "顶点焊接"

msgid "Merges duplicate vertices, Does not efect the out put polygon or vertext data"
msgstr "合并重复的顶点，不影响输出多边形或顶点数据"

msgid "Debug Info"
msgstr "调试信息"

msgid "Enables terminal output of detailed diagnostics during auto unwrap processing"
msgstr "启用自动展开处理期间终端输出的详细诊断信息"

msgid "Extra Arguments"
msgstr "额外参数"

msgid "Extended command line arguments that can be passed to the uv unwrapping application"
msgstr "可以传递给 UV 展开应用程序的扩展命令行参数"

msgid "Can not create: {ZUV_OT_AutoUVUnwrap.LITERAL_PRESET_AUTO_UV_UNWRAP} - directory!"
msgstr "无法创建：{ZUV_OT_AutoUVUnwrap.LITERAL_PRESET_AUTO_UV_UNWRAP} - 目录！"

msgid "OFFLINE - Allow Online Access in Blender Preferences to continue!"
msgstr "离线 - 在 Blender 首选项中允许在线访问以继续！"

msgid "Texel Density"
msgstr "纹理密度"

msgid "Set current Texel Density value: {td_props.prp_current_td}"
msgstr "设置当前 Texel Density 值：{td_props.prp_current_td}"

msgid "Install {ZUV_OT_AutoUVUnwrap.LITERAL_UNWRAPPER_APPLICATION}!"
msgstr "安装 {ZUV_OT_AutoUVUnwrap.LITERAL_UNWRAPPER_APPLICATION}！"

msgid "No objects were processed during auto unwrap!"
msgstr "自动 unwrap 期间未处理任何对象！"

msgid "Can not import auto unwrapped object!"
msgstr "无法导入自动 unwrap 的对象！"

msgid "Can not auto unwrap given mesh! Check parameters!"
msgstr "无法对给定的 mesh 进行自动 unwrap！请检查参数！"

msgid "Export failed!"
msgstr "导出失败！"

msgid "Corrected UV Faces: {i_corrected_uvs}"
msgstr "已修正 UV 面：{i_corrected_uvs}"

msgctxt "Operator"
msgid "Download Auto UV Unwrapper"
msgstr "下载自动 UV Unwrapper"

msgid "Download and install auto uv unwrapper from {MinistryOfFlatData.URL_MINISTRY_OF_FLAT}"
msgstr "从 {MinistryOfFlatData.URL_MINISTRY_OF_FLAT} 下载并安装自动 UV 展开器。"

msgid "You are about to download \"UV Automated Unwrapper\" from the Ministry of Flat."
msgstr "您即将从“扁平部”下载\"UV 自动展开器”。"

msgid "Please note that by pressing the \"OK\" button, you acknowledge that you have read and agree"
msgstr "请注意，点击“确定”按钮即表示您已阅读并同意"

msgid "to the terms and conditions of the free license associated with this tool."
msgstr "有关本工具所附免费许可协议的条款和条件。"

msgid "We recommend reviewing these terms carefully to understand your rights and responsibilities."
msgstr "我们建议您仔细阅读这些条款，以了解您的权利和责任。"

msgid "Author: {MinistryOfFlatData.MINISTRY_OF_FLAT_AUTHOR}"
msgstr "作者：{MinistryOfFlatData.MINISTRY_OF_FLAT_AUTHOR}"

msgid "To access the terms and conditions, please visit:"
msgstr "要访问条款和条件，请访问："

