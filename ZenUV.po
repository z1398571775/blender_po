msgstr "清除接缝"

msgid "Remove all marked UV seams from mesh edges before preparing for a new unwrap"
msgstr "在准备新展开之前，从网格边缘中移除所有标记的 UV 接缝"

msgid "Clear Sharps"
msgstr "清除尖锐边"

msgid "Remove all sharp edge markings from the mesh before preparing for a new unwrap"
msgstr "在准备新展开之前，从网格中移除所有尖锐边标记"

msgid "Tag Unfinished"
msgstr "标记未完成"

msgid "Remove all finished island marks and tag the mesh as unfinished for a fresh unwrap"
msgstr "移除所有已完成的岛屿标记并将网格标记为未完成，以便进行新的展开"

msgid "Apply Scale"
msgstr "应用缩放"

msgid "Apply object scale transformations before preparing the mesh for UV unwrapping"
msgstr "在准备网格进行 UV 展开之前，应用对象缩放变换"

msgid "Apply Modifiers"
msgstr "应用修改器"

msgid "Apply all geometry modifiers to the mesh before preparing for UV unwrapping"
msgstr "在准备进行 UV 展开之前，应用所有几何体修改器"

