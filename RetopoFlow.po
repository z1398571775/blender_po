msgstr "将凹面分割，使所有生成的面都变为凸面"

msgid "Triangulate Non-Planar Faces"
msgstr "三角化非共面面"

msgid "Splits faces that are not flat"
msgstr "分割不平坦的面"

msgid "Triangulate N-gons"
msgstr "三角化 N 边形"

