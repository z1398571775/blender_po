msgid "Merge by Distance"
msgstr "按距离合并"

msgid "Finds groups of vertices closer than the threshold and merges them together"
msgstr "查找距离阈值更近的顶点组并将其合并"

msgid "Merge Threshold"
msgstr "合并阈值"

msgid "Vertices less than this distance from each other will get merged together"
msgstr "距离小于此值的顶点将合并在一起"

msgid "Delete Loose Verts"
msgstr "删除多余顶点"

