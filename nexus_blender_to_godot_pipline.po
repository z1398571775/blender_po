msgid "Generates a BoxShape3D based on the object's bounding box."
msgstr "基于对象的边界框生成 BoxShape3D。"

msgid "Cylinder"
msgstr "Cylinder"

msgid "Generates a CylinderShape3D based on the object's bounding box."
msgstr "基于对象的边界框生成 CylinderShape3D。"

msgid "Sphere"
msgstr "Sphere"

msgid "Generates a SphereShape3D based on the object's bounding box."
msgstr "基于对象的边界框生成 SphereShape3D。"

msgid "Capsule"
msgstr "胶囊体"

msgid "Generates a CapsuleShape3D based on the object's bounding box."
msgstr "根据对象的边界框生成 CapsuleShape3D。"

msgid "Trimesh"
msgstr "三角网格"

msgid "Generates a ConcavePolygonShape3D from the mesh geometry (detailed, static collision)."
msgstr "从网格几何体（详细、静态碰撞）生成 ConcavePolygonShape3D。"

msgid "Convex Hull"
msgstr "凸包"

msgid "Generates a ConvexPolygonShape3D from the mesh geometry (simplified, dynamic collision)."
msgstr "从网格几何体（简化、动态碰撞）生成 ConvexPolygonShape3D。"

msgid "World Boundary"
msgstr "世界边界"

msgid "Generates a WorldBoundaryShape3D."
msgstr "生成 WorldBoundaryShape3D。"

msgid "Resonance Geometry"
msgstr "共振几何体"

msgid "Export as ResonanceStaticGeometry or ResonanceDynamicGeometry for spatial audio."
msgstr "导出为 ResonanceStaticGeometry 或 ResonanceDynamicGeometry，用于空间音频。"

msgid "Separation Ray"
msgstr "分离射线"

msgid "Exports a SeparationRayShape3D from this Empty (Single Arrow display, size = ray length)."
msgstr "从该空对象导出一个 SeparationRayShape3D（单箭头显示，大小 = 射线长度）。"

msgid "ResonanceStaticGeometry for static environment geometry."
msgstr "静态环境几何体的共振静态几何体。"

msgid "Dynamic"
msgstr "动态"

msgid "ResonanceDynamicGeometry for moving/animated geometry."
msgstr "移动/动画几何体的共振动态几何体。"

msgid "Dual Paraboloid"
msgstr "双抛物面"

msgid "Standard. Faster but may have artifacts."
msgstr "标准。更快但可能出现伪影。"

msgid "Cubemap"
msgstr "立方体贴图"

msgid "Slower, but more accurate shadows (e.g., for important lights)."
msgstr "更慢，但阴影更准确（例如，对于重要光源）。"

msgid "Light is not baked in static/global illumination."
msgstr "静态/全局光照中不会烘焙光线。"

msgid "Baked as static light in global illumination."
msgstr "作为全局光照中的静态光烘焙。"

msgid "Baked as dynamic light in global illumination."
msgstr "作为全局光照中的动态光烘焙。"

msgid "Automatic"
msgstr "自动"

msgid "Area lights use area_texture; other types use light_projector."
msgstr "区域灯光使用 area_texture；其他类型使用 light_projector。"

msgid "Area Surface"
msgstr "区域表面"

msgid "Export gobo as Godot AreaLight3D area_texture."
msgstr "将 gobo 导出为 Godot AreaLight3D area_texture。"

msgid "Projector"
msgstr "投影器"

msgid "Export gobo as Godot light_projector (requires shadows)."
msgstr "将 gobo 导出为 Godot light_projector（需要阴影）。"

msgid "Do not export gobo texture."
msgstr "不导出 gobo 纹理。"

msgid "Object UUID"
msgstr "对象 UUID"

msgid "A unique, persistent ID for this object instance."
msgstr "此对象实例的唯一持久 ID。"

msgid "Collision Type"
msgstr "碰撞类型"

msgid "Set as Preview"
msgstr "设置为预览"

msgid "Blender viewport preview only. The object is excluded from the glTF export entirely."
msgstr "仅 Blender 视口预览。该对象完全从 glTF 导出中排除。"

msgid "Discard Mesh"
msgstr "丢弃网格"

msgid "Exports mesh geometry for collision, but removes the visual MeshInstance in Godot on import (collision-only)."
msgstr "导出用于碰撞的网格几何体，但在导入到 Godot 时移除视觉 MeshInstance（仅碰撞）。"

msgid "Collision Margin Multiplier"
msgstr "碰撞边距乘数"

msgid "Multiplier applied to the calculated primitive collision size (e.g., 1.0 means no change)."
msgstr "应用于计算出的原形碰撞大小（例如，1.0 表示无变化）。"

msgid "Apply Scale"
msgstr "应用缩放"

msgid "If enabled, scale will be applied to the object before export (like Ctrl+A)."
msgstr "如果启用，导出前将对对象应用缩放（类似于 Ctrl+A）。"

msgid "Preserve Origin"
msgstr "保留原点"

msgid "If disabled, the origin will be set to the center of the geometry bounds before export."
msgstr "如果禁用，导出前将原点设置为几何体边界中心。"

msgid "Size X"
msgstr "X 尺寸"

msgid "Size Y"
msgstr "Y 尺寸"

msgid "Size Z"
msgstr "Z 尺寸"

msgid "Radius"
msgstr "半径"

msgid "Height"
msgstr "高度"

msgid "Offset X"
msgstr "X 偏移量"

msgid "Offset Y"
msgstr "Y 偏移量"

msgid "Offset Z"
msgstr "Z 偏移量"

msgid "Separation Ray Length"
msgstr "分离射线长度"

msgid "Slide on Slope"
msgstr "斜坡滑动"

msgid "If enabled, the ray can slide on slopes (Godot SeparationRayShape3D.slide_on_slope)."
msgstr "如果启用，射线可以在斜坡上滑动（Godot SeparationRayShape3D.slide_on_slope）。"

msgid "Custom Solver Bias"
msgstr "自定义求解器偏置"

msgid "Custom contact separation bias for this shape (0 = project default)."
msgstr "此形状的自定义接触分离偏置（0 = 使用默认值）。"

msgid "Margin"
msgstr "边距"

msgid "Collision margin in meters (Godot Shape3D.margin)."
msgstr "碰撞边距，单位为米（Godot Shape3D.margin）。"

msgid "Saved Empty Display Type"
msgstr "保存的空显示类型"

msgid "Previous empty_display_type before switching to Separation Ray."
msgstr "切换到分离射线之前的空显示类型。"

msgid "Custom metadata overriding/extending Collection metadata for this object. Types: float, int, bool, string, StringName."
msgstr "覆盖/扩展此对象的集合元数据。类型：float、int、bool、string、StringName。"

msgid "Geometry Type"
msgstr "几何类型"

msgid "Static for non-moving geometry, Dynamic for animated/moving geometry."
msgstr "静态用于非移动几何体，动态用于动画/移动的几何体。"

msgid "Resonance Material"
msgstr "esonanceMaterial.tres 文件（res://）。"

msgid "Path to a ResonanceMaterial .tres file (res://) for spatial audio surface properties."
msgstr "空间音频表面属性的共振材料.tres 文件路径（res://）。"

msgid "Set as Animation Anchor"
msgstr "设为动画锚点"

msgid "Uses this object's pivot as the animation reference point. Godot retargets animation tracks to the asset root so all objects in the collection move together."
msgstr "使用此对象的枢轴点作为动画参考点。Godot 将动画轨道重新目标化到资产根节点，因此集合中的所有对象会一起移动。"

msgid "Set as Origin Pivot"
msgstr "设置原点枢轴"

msgid "Marks this object as the collection origin. On export, all collection contents are translated so this pivot sits at world center while keeping relative offsets."
msgstr "将此对象标记为集合的原点。在导出时，所有集合内容都会被转换，使该枢轴点位于世界中心，同时保持相对偏移量。"

msgid "Attach to Bone"
msgstr "绑定到骨骼"

msgid "Export this object as a Godot BoneAttachment3D node."
msgstr "将此对象导出为 Godot BoneAttachment3D 节点。"

msgid "Bone Name"
msgstr "骨骼名称"

msgid "The name of the bone to which this object will be attached."
msgstr "要附加此对象的骨骼名称。"

msgid "Max Distance"
msgstr "最大距离"

msgid "Distance in meters where the asset disappears completely."
msgstr "资产完全消失的距离（米）。"

msgid "Fade Transition"
msgstr "淡入淡出过渡效果"

msgid "Percentage of the distance used for cross-fading (0.1 = 10%)."
msgstr "交叉淡入淡出所使用距离的百分比（0.1=10%）。"

msgid "LOD Bias"
msgstr "LOD 偏差"

msgid "Distribution curve. 1.0 = Linear. >1.0 = Pushes LOD transitions further away."
msgstr "分布曲线。1.0=线性。>1.0=将 LOD 过渡推得更远。"

msgid "Is Godot Placeholder"
msgstr "Godot 占位符"

msgid "If enabled, this Empty will be replaced by a specific Godot Scene (.tscn) or Resource upon import."
msgstr "如果启用，此空对象在导入时将替换为特定的 Godot 场景 (.tscn) 或资源。"

msgid "The path to the Godot resource (e.g. res://actors/player.tscn)."
msgstr "Godot 资源的路径（例如 res://actors/player.tscn）。"

msgid "Export as Path3D"
msgstr "导出为路径 3D"

msgid "If enabled, this curve is exported as a Godot Path3D (Curve3D). If disabled, it is exported as visual geometry (Mesh)."
msgstr "如果启用，此曲线将导出为 Godot 路径（Path3D）。如果禁用，它将导出为视觉几何体（网格）。"

msgid "Physics Surface Override"
msgstr "物理表面覆盖"

msgid "Optional path to a Godot PhysicsMaterial (.phymat) to override collision surface properties for this object."
msgstr "可选路径，指向一个 Godot 物理材质文件（.phymat），用于覆盖此对象的碰撞表面属性。"

msgid "Shadow Mode"
msgstr "阴影模式"

msgid "The method Godot uses for calculating OmniLight shadows (Dual Paraboloid or Cubemap)."
msgstr "Godot 用于计算全向灯光（双抛物面或立方体贴）阴影的方法。"

msgid "Indirect Energy"
msgstr "间接能量"

msgid "Godot light_indirect_energy multiplier for global illumination."
msgstr "Godot 全局光照的间接能量乘数。"

msgid "Volumetric Fog Energy"
msgstr "体积雾能量"

msgid "Godot light_volumetric_fog_energy multiplier."
msgstr "Godot 体积雾能量乘数。"

msgid "Specular"
msgstr "高光"

msgid "Godot light_specular multiplier for specular highlights."
msgstr "Godot 高光乘数，用于高光效果。"

msgid "Bake Mode"
msgstr "烘焙模式"

msgid "Godot light_bake_mode for global illumination baking."
msgstr "Godot light_bake_mode（全局光照烘焙）。"

msgid "Cull Mask"
msgstr "剔除掩码"

msgid "Lower 20 bits of Godot light_cull_mask (visibility layers)."
msgstr "Godot light_cull_mask 的低 20 位（可见性层）。"

msgid "Caster Mask"
msgstr "投射器掩码"

msgid "Lower 20 bits of Godot shadow_caster_mask (layers that cast shadows)."
msgstr "Godot shadow_caster_mask 的低 20 位（投射阴影的层）。"

msgid "Angular Distance"
msgstr "角度距离"

msgid "Godot DirectionalLight3D light_angular_distance (soft shadow size)."
msgstr "上帝之光 3D 光_角度距离（柔和阴影大小）。"

msgid "Light Size"
msgstr "光照尺寸"

msgid "Godot DirectionalLight3D light_size for soft shadows."
msgstr "上帝之光 3D light_size 用于柔和阴影。"

msgid "Negative Light"
msgstr "负光照"

msgid "Godot light_negative subtracts light instead of adding it."
msgstr "Godot light_negative 减去而非添加光照。"

msgid "Reverse Cull Face"
msgstr "反向剔除面"

msgid "Godot shadow_reverse_cull_face flips shadow face culling for thin geometry."
msgstr "Godot shadow_reverse_cull_face 翻转薄几何体的阴影剔除面。"

msgid "Normal Bias"
msgstr "法线偏移"

msgid "Godot shadow_normal_bias offsets shadow lookup by surface normal."
msgstr "Godot shadow_normal_bias 通过表面法线偏移阴影查找。"

msgid "Transmittance Bias"
msgstr "透射率偏移"

msgid "Godot shadow_transmittance_bias for translucent shadow receivers."
msgstr "Godot shadow_transmittance_bias 用于半透明阴影接收器。"

msgid "Opacity"
msgstr "不透明度"

msgid "Godot shadow_opacity (1.0 = opaque shadows)."
msgstr "Godot shadow_opacity（1.0 = 不透明阴影）。"

msgid "Attenuation"
msgstr "衰减"

msgid "Godot OmniLight3D omni_attenuation."
msgstr "Godot OmniLight3D omni_attenuation。"

msgid "Godot SpotLight3D spot_attenuation."
msgstr "Godot SpotLight3D spot_attenuation。"

msgid "Angle Attenuation"
msgstr "角度衰减"

msgid "Godot spot_angle_attenuation (rim softness). Set below 0 to derive from Blender Beam Shape Blend on export. Not mapped to Beam Shape Blend because Blender uses inner/outer cones."
msgstr "Godot spot_angle_attenuation（边缘柔化度）。设置低于 0 以导出时从 Blender Beam Shape Blend 推导。未映射到 Beam Shape Blend，因为 Blender 使用内/外圆锥。"

msgid "Range"
msgstr "范围"

msgid "Godot AreaLight3D area_range in meters."
msgstr "Godot AreaLight3D area_range（单位为米）。"

msgid "Godot AreaLight3D area_attenuation (2.0 for physically accurate falloff)."
msgstr "Godot AreaLight3D area_attenuation（2.0 用于物理准确的衰减）。"

msgid "Normalize Energy"
msgstr "Normalize Energy"

msgid "Godot AreaLight3D area_normalize_energy keeps total output stable when resizing."
msgstr "Godot AreaLight3D area_normalize_energy 在调整大小时保持总输出稳定。"

msgid "Shadow Normal Bias"
msgstr "Shadow Normal Bias"

msgid "Godot AreaLight3D shadow_normal_bias."
msgstr "Godot AreaLight3D shadow_normal_bias。"

msgid "Gobo Export Mode"
msgstr "Gobo Export Mode"

msgid "How an Image Texture on the light node tree is exported to Godot."
msgstr "图像纹理如何从灯光节点树导出到 Godot。"

msgid "Cell Size"
msgstr "Cell Size"

msgid "The size of the raster cells used for NavMesh baking."
msgstr "用于 NavMesh 烘焙的栅格单元格的大小。"

msgid "Agent Height"
msgstr "Agent Height"

msgid "The minimum height an agent needs to pass through an area."
msgstr "代理通过区域所需的最小高度。"

msgid "Agent Radius"
msgstr "代理半径"

msgid "The radius of the navigating agent."
msgstr "导航代理的半径。"

msgid "Max Travel Cost"
msgstr "最大旅行成本"

msgid "The 'Travel Cost' value in Godot when the vertex color is fully Red (1.0)."
msgstr "Godot 中顶点颜色为完全红色（1.0）时的“旅行成本”值。"

