msgstr "值"

msgid "Value as text. For Bool: 'true', 'false', '1', '0', 'yes', 'no', 'on', 'off'."
msgstr "作为文本的值。对于 Bool：'true', 'false', '1', '0', 'yes', 'no', 'on', 'off'。"

msgid "No collision shape will be generated for this object."
msgstr "不会为该对象生成碰撞形状。"

