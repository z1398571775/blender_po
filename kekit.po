msgctxt "Operator"
msgid "VP-Transform"
msgstr "VP 变换"

msgid "Runs Grab,Rotate or Scale with View Planes auto-locked based on your viewport rotation."
msgstr "基于您的视口旋转自动锁定视图平面，运行抓取、旋转或缩放操作。"

msgid "Transform"
msgstr "变换"

msgid "Translate"
msgstr "平移"

msgid "Duplicate & Move"
msgstr "复制并移动"

msgid "No objects selected"
msgstr "未选择任何对象"

msgctxt "Operator"
msgid "VP Flip"
msgstr "VP 翻转"

msgid ""
"Link-Duplicate (option) & Rotate Object around -180° and place facing the original (slighly offset)\n"
"Using Axis to closest Global axis to View port camera angle.\n"
"(Similar to Mouse Mirror, but no scaling, just loc & rot)"
msgstr ""
"链接复制（选项）& 围绕 -180°旋转对象并使其朝向原始位置（略微偏移）\n"
"使用轴与最接近全局轴的视图端口相机角度。\n"
"（类似于鼠标镜像，但无缩放，仅位置和旋转）"

msgid "Linked"
msgstr "链接"

msgctxt "Operator"
msgid "VP Step Rotate"
msgstr "VP 旋转步骤"

msgid ""
"Rotate object or selected elements given angle, based on viewport relative to the object.\n"
"Local, Cursor & View - else Global orientation."
msgstr ""
"以对象为参照，根据视口相对角度旋转对象或选定元素。\n"
"本地、光标和视图——否则使用全局方向。"

msgid "Pie Menu custom prop (ignore)"
msgstr "饼图菜单自定义属性（忽略）"

msgid "No Context Object?"
msgstr "未找到上下文对象？"

msgid "NONE"
msgstr "无"

msgid "Toggles specified weighting on or off on selected elements"
msgstr "在选定的元素上开启或关闭指定的权重"

msgid "Edge Group"
msgstr "边缘组"

msgid "Weight Type"
msgstr "权重类型"

msgid "Bevel Weight"
msgstr "倒角权重"

msgid "Crease Weight"
msgstr "折痕权重"

msgid "Seam"
msgstr "接缝"

msgid "Sharp"
msgstr "锐利"

msgid "Invalid selection mode - use Edge/Face mode."
msgstr "无效的选择模式 - 请使用边/面模式。"

msgctxt "Operator"
msgid "Wonkify"
msgstr "Wonkify"

msgid ""
"OBJECT MODE: Applies minor random transform per VERT, PART or OBJECT - adding a SHAPE KEY\n"
"EDIT MODE: Uses Edges/Faces SELECTION Island(s) similar to 'Part' operation"
msgstr ""
"对象模式：对每个顶点、部件或对象应用微小的随机变换 - 添加形状键\n"
"编辑模式：使用与“部件”操作类似的边/面选择区域"

msgid "Per Object"
msgstr "单个对象"

msgid "Random transform applied per Object as Shape Key"
msgstr "按对象应用随机变换作为形状键"

msgid "Per Part"
msgstr "单个部件"

msgid "Random transform applied per Part (per object) as Shape Key"
msgstr "按部件（每个对象）应用随机变换作为形状键"

msgid "Per Vert"
msgstr "每个顶点"

msgid "Random transform applied per Vert (per object) as Shape Key"
msgstr "按形状键应用随机变换（每个对象）"

msgid "Shape Key Value"
msgstr "形状键值"

msgid "The Wonkify Shape Key Value (same as in Properties/Data panel)"
msgstr "Wonkify 形状键值（与属性/数据面板中的相同）"

msgid "Override Wonk-factor"
msgstr "覆盖 Wonk 因子"

msgid "If not 0: Replaces the default automatic Wonk-factor (that's based on shortest edge %)"
msgstr "如果非 0：替换默认的自动 Wonk 因子（基于最短边百分比）"

msgid "Replace Wonkify SK"
msgstr "替换 Wonkify SK"

msgid ""
"ON: Overwrites Wonkify Shape Key (if already in use)\n"
"OFF: Will add more Wonkify Shape Keys"
msgstr ""
"ON：覆盖已使用的 Wonkify 形状键\n"
"OFF：将添加更多 Wonkify 形状键"

msgid "Use Delta TF"
msgstr "使用 Delta TF"

msgid "Non-mesh Objects: Use Delta Transform instead of regular Tf"
msgstr "非网格对象：使用 Delta Transform 代替常规 Tf"

msgid "Wonk Factor"
msgstr "Wong 系数"

msgid "Set Wonk-factor for non-mesh objects"
msgstr "为非网格对象设置 Wonk 因子"

msgid "Non-Mesh Mode:"
msgstr "非网格模式:"

msgid "Wonkify"
msgstr "Wong 化"

msgctxt "Operator"
msgid "Zero Local"
msgstr "零本地"

msgid ""
"Temporarily stores & zeroes Loc+Rot & sets Local View. \n"
"Run ZeroLocal again to exit Local View & restore rotation\n"
"+If no rot/loc -> just Local View"
msgstr ""
"临时存储并归零位置与旋转，同时设置局部视图。\n"
"再次运行 ZeroLocal 可退出局部视图并恢复旋转\n"
"+若无旋转/位置 -> 仅显示局部视图"

msgid "Not in Local View but has stored values: Copy/Remove manually (Custom Prop)"
msgstr "不在局部视图中但已保存数值：手动复制/移除（自定义属性）"

msgid "UV Sync Selection must be disabled"
msgstr "必须禁用 UV Sync Selection"

msgid "UVMap"
msgstr "UVMap"

msgid "No UV's selected?"
msgstr "未选择任何 UV？"

